API_KEY=change-me-very-strong-token

#MODEL_PATH=thinkingmachines/Inkling-2-Mini
#SERVED_MODEL_NAME=inkling-2-mini

# DGX Spark (GB10) verified recipe: TP1 / EP1, FA4 attention, BF16, page 128.
# Keep EP == TP: NVFP4 experts cannot be TP-sharded (activation scales must
# cover each expert's full input width).
#TP_SIZE=1
#EP_SIZE=1
#ATTENTION_BACKEND=fa4
#DTYPE=bfloat16
#PAGE_SIZE=128
#GRAMMAR_BACKEND=xgrammar
# Leave BF16_GEMM_BACKEND empty for the default BF16 GEMM backend (adds
# small-batch decode GEMVs on GB10, which the verified recipe relies on).
#BF16_GEMM_BACKEND=

# DGX Spark memory: weights ~18 GB on 128 GB unified LPDDR5X.
#MEM_FRACTION_STATIC=0.45
# Leave CONTEXT_LENGTH empty to use the model default (1,048,576). Lower it
# (e.g. 65536) to leave more room for the KV pool / concurrency.
#CONTEXT_LENGTH=
#MAX_RUNNING_REQUESTS=
#MAX_QUEUED_REQUESTS=

# Strategy: Balanced (plain decode) or DSpark (speculative decoding on the
# bundled MTP draft head). DSpark sets 8 draft tokens per step.
#ENABLE_DSPARK=0
#SPECULATIVE_NUM_DRAFT_TOKENS=8

# Loop-core knobs: only valid on the variable-loop research checkpoint
# (loop_config.is_varloop=true). Leave empty on the main checkpoint.
#INKLING2_LOOP_NUM_PASSES=
#INKLING2_LOOP_SHARE_CACHE=0

# Multimodal / parsers / tools
#ENABLE_MULTIMODAL=1
#ENABLE_REASONING=1
#ENABLE_TOOLS=1
#TOOL_SERVER=

# Optional runtime tuning
# CHUNKED_PREFILL_SIZE=
#KV_CACHE_DTYPE=
#ENABLE_MIXED_CHUNK=0
#ENABLE_SLEEP_ON_IDLE=0

# DGX Spark sets MAX_JOBS=4 in the verified recipe (limits parallel build jobs).
#MAX_JOBS=4

#HF_HOME=${HOME}/.cache/huggingface
#HF_HUB_CACHE=${HF_HOME}
#TRANSFORMERS_CACHE=${HF_HOME}

#HTTP_PORT=30000
#SHM_SIZE=16g
#GPU_DEVICE=all
#RESTART_POLICY=unless-stopped

# Watchdog for stuck /health (detokenizer heartbeat timeouts)
#HEALTHCHECK_MONITOR_START_GRACE=1800
#HEALTHCHECK_MONITOR_INTERVAL=15
#HEALTHCHECK_MONITOR_MAX_FAILURES=8

# HF_TOKEN=hf_xxx
# ADMIN_API_KEY=change-me-admin-token

# Build / image settings
# BASE_IMAGE=lmsysorg/sglang:inkling-2-mini
# IMAGE_NAME=inkling-2-mini-sglang:latest
# CONTAINER_NAME=inkling-2-mini-sglang
# UPGRADE_SGLANG=0
# UPGRADE_TRANSFORMERS=0
# SGLANG_WHL_INDEX=https://docs.sglang.ai/whl/cu130/
# FLASHINFER_DISABLE_VERSION_CHECK=1